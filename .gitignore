# --- Build logs and journals (Vivado, Vitis, make captures) ---
*.log
*.jou

# --- Vivado: generated project dir, exported hardware, temp/debug files ---
# The BD/project is regenerated from vivado/mktdata_poc.tcl (+ build.tcl), and the
# XSA from `make xsa`; none of it belongs in git. Tracked sources (vivado/*.tcl,
# vivado/ip/*, vivado/constraints.xdc, vivado/Makefile) are NOT matched here.
vivado/mktdata_poc/
*.xsa
*.backup.jou
*.backup.log
*.str
*.debug
.Xil/
.hbs
hd_visual/
usage_statistics_webtalk.*
webtalk*.log
webtalk*.jou

# --- Vitis Classic: disposable workspaces (xsct build.tcl regenerates them) ---
vitis_ws/

# --- Cross-compiled / native test binaries (regenerated by make / gcc) ---
apps/mktdata_poc_test/mktdata_poc_test
apps/mktdata_poc_test/fifoexp
apps/mktdata_poc_test/fifo16

# --- Editor / OS cruft ---
*.swp
*~
.DS_Store
